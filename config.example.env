# Example environment variables for FRIDAY (do not store secrets here)

# Path to your local quantized model binary (GGML / gpt4all / llama cpp compatible)
LOCAL_MODEL_PATH=./models/your-model.bin

# Very-low, low-mid, mid-high
MODE=very-low

# Memory DB path
FRIDAY_MEMORY_DB=friday_memory.db

# Maximum memory (MB) for internal caches
MAX_MEMORY_MB=512

# CPU threads to use for local inference
THREADS=4

# Embedding model (sentence-transformers) for local embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
