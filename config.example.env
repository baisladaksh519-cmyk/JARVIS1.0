# FRIDAY configuration example (do NOT commit secrets)

# Path to your local quantized model binary (GGML / gpt4all / llama cpp compatible)
LOCAL_MODEL_PATH=./models/your-model.bin

# Operation mode: very-low | low | default
MODE=very-low

# Memory limits - preferred: MAX_MEMORY_MB (approximate). The memory store also supports FRIDAY_MAX_ENTRIES.
FRIDAY_MAX_MEMORY_MB=512
FRIDAY_MAX_ENTRIES=500

# Context size limits (characters) - used to trim context in prompts
CONTEXT_MAX_CHARS=4000

# CPU threads to use for local inference
THREADS=4

# Embedding model (optional) for local embeddings. Leave unset to skip embeddings.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Voice (optional) - set to true to enable voice hooks (still requires local TTS/STT installs)
VOICE_ENABLED=false
